PORT=8080

# Format DSN Go: user:password@tcp(host:port)/database?opsi
# Wajib ada "?" dan parseTime=True
DB_DSN=root:password@tcp(127.0.0.1:3306)/karsa?charset=utf8mb4&parseTime=True&loc=Local

# Buat dengan: openssl rand -hex 32
JWT_SECRET=

FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8080
UPLOAD_DIR=uploads

# Mailpit: SMTP di 1025, inbox web di http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@karsa.test

# true = isi data demo saat server menyala, hanya kalau tabel users kosong
RUN_SEED=false
